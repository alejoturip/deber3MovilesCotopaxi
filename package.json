{
  "name": "cotopaxi-focus",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-constants": "~54.0.0",
    "expo-dev-client": "~54.0.0",
    "expo-linking": "~54.0.0",
    "expo-notifications": "~54.0.0",
    "expo-router": "~54.0.0",
    "expo-status-bar": "~54.0.0",
    "react": "18.2.0",
    "react-native": "0.87.0",
    "react-native-safe-area-context": "~4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-svg": "15.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/react": "~18.2.0",
    "jest": "^29.0.0",
    "jest-expo": "~54.0.0",
    "react-dom": "18.2.0",
    "typescript": "~5.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:apk": "npx eas-cli@latest build -p android --profile preview",
    "sync:claude": "node scripts/sync-claude.mjs",
    "build:dev": "npx eas-cli@latest build -p android --profile development",
    "start:go": "expo start --go"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "description": "App Pomodoro para el Departamento de Bienestar Estudiantil de la Academia Cotopaxi (Deber N°3 - Desarrollo App Móviles, ESFOT-EPN)"
}
